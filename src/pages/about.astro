---
const name = "Venkat Krishnan";
const title = "Director of Transportation Technology, 3M";
const companies = ["Oracle", "JDA", "GM", "Microsoft", "3M"];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About | IMI Lab</title>
</head>
<body class="bg-gray-50 font-sans">
  <header class="bg-slate-900 text-white">
    <nav class="max-w-4xl mx-auto px-4 py-6 flex justify-between items-center">
      <a href="/" class="text-xl font-bold">← IMI Lab</a>
      <div class="flex gap-6 text-sm">
        <a href="/blog" class="text-slate-300 hover:text-white">All Articles</a>
        <a href="/about" class="text-white font-medium">About</a>
      </div>
    </nav>
  </header>

  <main class="max-w-4xl mx-auto px-4 py-16">
    <div class="bg-white rounded-lg shadow-sm border p-8 md:p-12">
      <div class="w-20 h-20 bg-slate-200 rounded-full mx-auto mb-6 flex items-center justify-center text-2xl">
        👤
      </div>
      
      <h1 class="text-3xl font-bold text-center mb-2">IMI Lab</h1>
      <p class="text-slate-500 text-center mb-8">Exploring technology-driven supply chains</p>
      
      <div class="prose prose-lg max-w-none mb-10">
        <p class="text-gray-700 leading-relaxed mb-6">
          Supply chain is my passion — from planning to execution. I've built platforms and advised Fortune 500 leaders across {companies.join(", ")}. Always exploring how AI can make supply chains smarter.
        </p>
        
        <p class="text-gray-700 leading-relaxed mb-6">
          <strong>IMI</strong> (ʻimi) in Hawaiian means to seek, explore, discover. This blog is where I share what I learn.
        </p>

        <div class="bg-slate-50 border rounded-lg p-6 mb-6">
          <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-3">How This Works</h2>
          <p class="text-gray-700 text-sm leading-relaxed">
            IMI Lab is entirely automated. I suggest topics — AI researches, writes, and publishes daily articles. 
            Built with <a href="https://astro.build" class="text-blue-600 hover:underline">Astro</a>, 
            hosted on <a href="https://pages.cloudflare.com" class="text-blue-600 hover:underline">Cloudflare Pages</a>, 
            content generated by <a href="https://kimi.moonshot.cn" class="text-blue-600 hover:underline">Kimi AI</a>. 
            Zero manual editing. Pure experimentation at the intersection of supply chain and AI.
          </p>
        </div>

        <p class="text-gray-700 leading-relaxed">
          <strong>Curated by:</strong> {name}, {title}
        </p>
      </div>

      <div class="border-t pt-8">
        <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-4">Connect</h2>
        <div class="flex flex-wrap gap-4">
          <a href="mailto:venkataramanik@gmail.com" class="px-4 py-2 bg-slate-900 text-white rounded-lg text-sm font-medium hover:bg-slate-800">Contact</a>
          <a href="https://www.linkedin.com/in/venkrish1/" class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium hover:bg-slate-50">LinkedIn</a>
          <a href="https://github.com/venkataramanik" class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium hover:bg-slate-50">GitHub</a>
        </div>
      </div>
    </div>

    <!-- Subscribe Section -->
    <div class="mt-12 bg-blue-50 border border-blue-100 rounded-lg p-8 text-center">
      <h2 class="text-xl font-bold text-blue-900 mb-2">Stay Updated</h2>
      <p class="text-blue-700 mb-6">Exploring technology-driven supply chains</p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/rss.xml" 
           class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3z" />
            <path d="M4 9a1 1 0 011-1 7 7 0 017 7 1 1 0 11-2 0 5 5 0 00-5-5 1 1 0 01-1-1zM3 15a2 2 0 114 0 2 2 0 01-4 0z" />
          </svg>
          RSS Feed
        </a>
      </div>
      
      <p class="text-sm text-blue-600 mt-4">
        Email subscriptions coming soon.
      </p>
    </div>
  </main>

  <footer class="bg-slate-900 text-slate-400 py-12 text-center">
    <p>&copy; {new Date().getFullYear()} IMI Lab</p>
    <p class="text-sm mt-1">To seek is to know</p>
  </footer>
</body>
</html>
