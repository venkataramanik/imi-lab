---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.pubDate - a.data.pubDate);
const featured = sorted.find(p => p.data.featured);
const recent = sorted.filter(p => p !== featured).slice(0, 5);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>IMI Lab | Supply Chain Innovation</title>
</head>
<body class="bg-gray-50 font-sans">
  <header class="bg-white border-b">
    <nav class="max-w-4xl mx-auto px-4 py-4 flex justify-between">
      <a href="/" class="text-2xl font-bold text-blue-900">IMI Lab</a>
      <a href="/blog" class="text-gray-600">Blog</a>
    </nav>
  </header>

  <section class="bg-blue-900 text-white py-20 text-center">
    <h1 class="text-5xl font-bold mb-4">Supply Chain Intelligence</h1>
    <p class="text-xl text-blue-200">Daily insights on warehousing, transportation, and AI</p>
  </section>

  <main class="max-w-4xl mx-auto px-4 py-16">
    {featured && (
      <div class="mb-12">
        <span class="text-blue-600 font-semibold">Featured</span>
        <h2 class="text-3xl font-bold mt-2">
          <a href={`/blog/${featured.slug}`}>{featured.data.title}</a>
        </h2>
        <p class="text-gray-600 mt-2">{featured.data.description}</p>
      </div>
    )}
    
    <h2 class="text-2xl font-bold mb-6">Latest</h2>
    {recent.map(post => (
      <div class="mb-6 border-b pb-6">
        <span class="text-sm text-blue-600">{post.data.category}</span>
        <h3 class="text-xl font-semibold">
          <a href={`/blog/${post.slug}`}>{post.data.title}</a>
        </h3>
        <p class="text-gray-600">{post.data.description}</p>
      </div>
    ))}
  </main>
</body>
</html>
