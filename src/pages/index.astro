---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.pubDate - a.data.pubDate);
const featured = sorted.find(p => p.data.featured);
const recent = sorted.filter(p => p !== featured).slice(0, 5);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Supply Chain Intelligence | Daily Insights</title>
  <meta name="description" content="Daily insights on warehousing, transportation, procurement, and AI for supply chain professionals." />
</head>
<body class="bg-gray-50 font-sans">
  <header class="bg-slate-900 text-white">
    <nav class="max-w-5xl mx-auto px-4 py-6 flex justify-between items-center">
      <div>
        <a href="/" class="text-2xl font-bold tracking-tight">Supply Chain Intelligence</a>
        <p class="text-slate-400 text-sm mt-1">Daily insights on warehousing, transportation, and AI</p>
      </div>
      <a href="/blog" class="text-slate-300 hover:text-white font-medium">All Articles</a>
    </nav>
  </header>

  <main class="max-w-5xl mx-auto px-4 py-12">
    {featured && (
      <section class="mb-16">
        <span class="text-sm font-semibold text-blue-600 uppercase tracking-wide">Featured</span>
        <h1 class="text-4xl md:text-5xl font-bold mt-3 mb-4 leading-tight">
          <a href={`/blog/${featured.slug}`} class="hover:text-blue-700 transition-colors">{featured.data.title}</a>
        </h1>
        <p class="text-xl text-gray-600 mb-4 max-w-3xl">{featured.data.description}</p>
        <div class="flex items-center gap-4 text-sm text-gray-500">
          <time datetime={featured.data.pubDate}>
            {new Date(featured.data.pubDate).toLocaleDateString('en-US', {month: 'long', day: 'numeric', year: 'numeric'})}
          </time>
          <span class="text-gray-300">|</span>
          <span class="text-blue-600 font-medium">{featured.data.category}</span>
        </div>
      </section>
    )}

    <section>
      <h2 class="text-2xl font-bold mb-8 pb-2 border-b">Latest Insights</h2>
      <div class="grid gap-8 md:grid-cols-2">
        {recent.map(post => (
          <article class="group">
            <span class="text-sm font-medium text-blue-600">{post.data.category}</span>
            <h3 class="text-xl font-semibold mt-2 mb-3 group-hover:text-blue-700 transition-colors">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h3>
            <p class="text-gray-600 mb-3 line-clamp-2">{post.data.description}</p>
            <time class="text-sm text-gray-500" datetime={post.data.pubDate}>
              {new Date(post.data.pubDate).toLocaleDateString('en-US', {month: 'short', day: 'numeric'})}
            </time>
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer class="bg-slate-900 text-slate-400 py-12 mt-20">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <p class="mb-2">&copy; {new Date().getFullYear()} Supply Chain Intelligence</p>
      <p class="text-sm">Automated daily insights for supply chain professionals</p>
    </div>
  </footer>
</body>
</html>
