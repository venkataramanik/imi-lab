---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.pubDate - a.data.pubDate);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>All Articles | IMI Lab</title>
</head>
<body class="bg-gray-50 font-sans">
  <header class="bg-slate-900 text-white">
    <nav class="max-w-5xl mx-auto px-4 py-6 flex justify-between items-center">
      <a href="/" class="text-xl font-bold">← IMI Lab</a>
      <a href="/about" class="text-slate-300 hover:text-white">About</a>
    </nav>
  </header>

  <main class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-2">All Articles</h1>
    <p class="text-gray-600 mb-10">Exploring technology-driven supply chains</p>
    
    <div class="space-y-8">
      {sorted.map(post => (
        <article class="bg-white p-6 rounded-lg shadow-sm border hover:shadow-md transition-shadow">
          <div class="flex items-center gap-3 mb-3">
            <span class="px-3 py-1 bg-blue-100 text-blue-800 text-sm font-medium rounded-full">{post.data.category}</span>
            <time class="text-sm text-gray-500" datetime={post.data.pubDate}>
              {new Date(post.data.pubDate).toLocaleDateString('en-US', {month: 'long', day: 'numeric', year: 'numeric'})}
            </time>
          </div>
          <h2 class="text-2xl font-bold mb-3">
            <a href={`/blog/${post.slug}`} class="hover:text-blue-700 transition-colors">{post.data.title}</a>
          </h2>
          <p class="text-gray-600 mb-4">{post.data.description}</p>
          <p class="text-sm text-gray-500">{post.data.tags.map((tag, i) => `#${tag}${i < post.data.tags.length - 1 ? ' ' : ''}`).join('')}</p>
        </article>
      ))}
    </div>

    <!-- Subscribe Section -->
    <section class="mt-16">
      <div class="bg-blue-50 border border-blue-100 rounded-lg p-8 text-center">
        <h2 class="text-2xl font-bold text-blue-900 mb-2">Stay Updated</h2>
        <p class="text-blue-700 mb-6">Exploring technology-driven supply chains</p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="/rss.xml" 
             class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3z" />
              <path d="M4 9a1 1 0 011-1 7 7 0 017 7 1 1 0 11-2 0 5 5 0 00-5-5 1 1 0 01-1-1zM3 15a2 2 0 114 0 2 2 0 01-4 0z" />
            </svg>
            RSS Feed
          </a>
        </div>
        
        <p class="text-sm text-blue-600 mt-4">
          Email subscriptions coming soon. <a href="/about" class="underline hover:text-blue-800">Contact me</a> for updates.
        </p>
      </div>
    </section>
  </main>

  <footer class="bg-slate-900 text-slate-400 py-12 mt-20 text-center">
    <p>&copy; {new Date().getFullYear()} IMI Lab</p>
    <p class="text-sm mt-1">To seek is to know</p>
  </footer>
</body>
</html>
