---
const { title, description, pubDate, category, tags } = Astro.props;
const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | IMI Lab</title>
  <meta name="description" content={description} />
</head>
<body class="bg-white text-gray-900 font-sans">
  <header class="bg-slate-900 text-white">
    <nav class="max-w-3xl mx-auto px-4 py-6 flex justify-between items-center">
      <a href="/" class="text-xl font-bold">← IMI Lab</a>
      <div class="flex gap-6 text-sm">
        <a href="/blog" class="text-slate-300 hover:text-white">All Articles</a>
        <a href="/about" class="text-slate-300 hover:text-white">About</a>
      </div>
    </nav>
  </header>
  
  <main class="max-w-3xl mx-auto px-4 py-12">
    <article>
      <header class="mb-10">
        <div class="flex items-center gap-3 mb-4">
          <span class="px-3 py-1 bg-blue-100 text-blue-800 text-sm font-medium rounded-full">{category}</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">{title}</h1>
        <p class="text-xl text-gray-600 mb-6 leading-relaxed">{description}</p>
        <div class="flex items-center gap-4 text-sm text-gray-500 border-b pb-8">
          <time datetime={pubDate}>{formattedDate}</time>
          {tags.length > 0 && (
            <>
              <span>•</span>
              <div class="flex gap-2">
                {tags.map(tag => <span class="text-gray-600">#{tag}</span>)}
              </div>
            </>
          )}
        </div>
      </header>
      
      <div class="prose prose-lg max-w-none prose-headings:font-bold prose-a:text-blue-600 hover:prose-a:text-blue-800">
        <slot />
      </div>
    </article>
  </main>
  
  <footer class="bg-slate-50 border-t py-12 mt-20">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <a href="/" class="text-blue-600 font-medium hover:text-blue-800">← Back to all articles</a>
    </div>
  </footer>
</body>
</html>
