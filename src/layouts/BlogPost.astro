---
const { title, description, pubDate, category, tags } = Astro.props;
const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | IMI Lab</title>
  <meta name="description" content={description} />
</head>
<body class="bg-white text-gray-900 font-sans">
  <header class="bg-slate-900 text-white">
    <nav class="max-w-3xl mx-auto px-4 py-6 flex justify-between items-center">
      <a href="/" class="text-xl font-bold">← IMI Lab</a>
      <div class="flex gap-6 text-sm">
        <a href="/blog" class="text-slate-300 hover:text-white">All Articles</a>
        <a href="/about" class="text-slate-300 hover:text-white">About</a>
      </div>
    </nav>
  </header>
  
  <main class="max-w-3xl mx-auto px-4 py-12">
    <article>
      <header class="mb-10">
        <div class="flex items-center gap-3 mb-4">
          <span class="px-3 py-1 bg-blue-100 text-blue-800 text-sm font-medium rounded-full">{category}</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">{title}</h1>
        <p class="text-xl text-gray-600 mb-6 leading-relaxed">{description}</p>
        <div class="flex items-center gap-4 text-sm text-gray-500 border-b pb-8">
          <time datetime={pubDate}>{formattedDate}</time>
          {tags.length > 0 && (
            <>
              <span>•</span>
              <div class="flex gap-2">
                {tags.map(tag => <span class="text-gray-600">#{tag}</span>)}
              </div>
            </>
          )}
        </div>
      </header>
      
      <div class="prose prose-lg max-w-none prose-headings:font-bold prose-a:text-blue-600 hover:prose-a:text-blue-800">
        <slot />
      </div>
    </article>

    <!-- Subscribe Section -->
    <section class="mt-16 pt-8 border-t">
      <div class="bg-blue-50 border border-blue-100 rounded-lg p-8 text-center">
        <h2 class="text-2xl font-bold text-blue-900 mb-2">Stay Updated</h2>
        <p class="text-blue-700 mb-6">Exploring technology-driven supply chains</p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="/rss.xml" 
             class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3z" />
              <path d="M4 9a1 1 0 011-1 7 7 0 017 7 1 1 0 11-2 0 5 5 0 00-5-5 1 1 0 01-1-1zM3 15a2 2 0 114 0 2 2 0 01-4 0z" />
            </svg>
            RSS Feed
          </a>
        </div>
        
        <p class="text-sm text-blue-600 mt-4">
          Email subscriptions coming soon. <a href="/about" class="underline hover:text-blue-800">Contact me</a> for updates.
        </p>
      </div>
    </section>
  </main>
  
  <footer class="bg-slate-900 text-slate-400 py-12 text-center">
    <p>&copy; {new Date().getFullYear()} IMI Lab</p>
    <p class="text-sm mt-1">To seek is to know</p>
  </footer>
</body>
</html>
