---
const { title, description, pubDate, category, tags } = Astro.props;
const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title} | IMI Lab</title>
  <meta name="description" content={description} />
</head>
<body class="bg-gray-50 text-gray-900 font-sans">
  <header class="bg-white border-b sticky top-0">
    <nav class="max-w-3xl mx-auto px-4 py-4 flex justify-between">
      <a href="/" class="text-xl font-bold text-blue-900">IMI Lab</a>
      <a href="/blog" class="text-gray-600">Blog</a>
    </nav>
  </header>
  
  <main class="max-w-3xl mx-auto px-4 py-12">
    <article class="prose prose-lg max-w-none">
      <span class="text-sm font-semibold text-blue-600 uppercase">{category}</span>
      <h1 class="text-4xl font-bold mt-2 mb-4">{title}</h1>
      <p class="text-gray-600 text-lg mb-4">{description}</p>
      <time class="text-sm text-gray-500">{formattedDate}</time>
      <div class="flex gap-2 mt-4">
        {tags.map(tag => <span class="px-3 py-1 bg-gray-200 rounded-full text-xs">{tag}</span>)}
      </div>
      <hr class="my-8" />
      <slot />
    </article>
  </main>
  
  <footer class="bg-gray-900 text-gray-400 py-8 text-center">
    <p>&copy; 2024 IMI Lab</p>
  </footer>
</body>
</html>
